begin_node_model "DrainDoping"
COMMAND node_model -device "part2_cell" -region "bulk" -display_type "scalar" -name "DrainDoping" -equation "(1e+19 * 2.500000000000000e-01 * erfc(((-(x + (-5.000000000000000e-05))) * pow(1.250000000000000e-06,(-1)))) * erfc(((y + (-5.000000000000000e-06)) * pow(5.000000000000000e-07,(-1)))));"
