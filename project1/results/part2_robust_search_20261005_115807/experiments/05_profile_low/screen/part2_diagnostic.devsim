begin_node_model "NetDoping"
COMMAND node_model -device "part2_cell" -region "bulk" -display_type "scalar" -name "NetDoping" -equation "(-(ifelse ((x < 2.000000000000000e-05), 7e+16, (ifelse ((x < 3.500000000000000e-05), 1e+15, (ifelse ((x <= 5.000000000000000e-05), 7e+16, 7e+16)))))) - TapDoping + DrainDoping + SourceDoping);"
end_node_model

